# Copy file này thành .env và điền key thật. KHÔNG commit .env lên git.
# Optional for local development (a random key is generated when empty).
# Production must use a unique random key with at least 50 characters.
DJANGO_SECRET_KEY=
# Production only (set these in hosting environment, not in a committed file):
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_ALLOWED_HOSTS=crm.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
# DJANGO_BEHIND_TLS_PROXY=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PUBLIC_BRAND_NAME=DigiFlow
PUBLIC_SITE_URL=http://127.0.0.1:8000
LEAD_FOLLOW_UP_LINK_TTL_DAYS=7
PUBLIC_CONTACT_EMAIL=demo-contact@digiflow.test
PUBLIC_DATA_CONTROLLER_NAME="DigiFlow (đơn vị vận hành bản demo)"
PUBLIC_PRIVACY_EMAIL=privacy@digiflow.test
PUBLIC_DATA_RETENTION_NOTICE="Bản demo local: dữ liệu được lưu trong SQLite đến khi người vận hành xóa; không dùng dữ liệu khách hàng thật."

# Superset analytics demo (all passwords/keys below are local placeholders).
# To use PostgreSQL with Django, set DJANGO_DATABASE_URL and install requirements-postgres.txt.
# Example format: postgresql://crm_app:password@127.0.0.1:5433/crm
DJANGO_DATABASE_URL=
CRM_DB_NAME=crm
CRM_DB_USER=crm_app
CRM_DB_PASSWORD=replace-with-a-local-demo-password
CRM_DB_ADMIN_PASSWORD=replace-with-a-separate-local-admin-password
CRM_DB_HOST_PORT=5433
SUPERSET_HOST_PORT=8088
# URL dùng khi chạy bootstrap từ máy host; nếu đổi SUPERSET_HOST_PORT thì đổi theo.
SUPERSET_URL=http://127.0.0.1:8088
SUPERSET_READONLY_PASSWORD=replace-with-a-different-local-demo-password
SUPERSET_META_PASSWORD=replace-with-another-local-demo-password
SUPERSET_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Local mặc định in email ra terminal. Chỉ đổi sang SMTP khi đã cấu hình tài khoản gửi.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=DigiFlow <no-reply@example.test>
