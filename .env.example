# Copy file này thành .env và điền key thật. KHÔNG commit .env lên git.
DJANGO_SECRET_KEY=django-insecure-dev-key-thay-doi-khi-trien-khai-that
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PUBLIC_BRAND_NAME=DigiFlow
PUBLIC_SITE_URL=http://127.0.0.1:8000
LEAD_FOLLOW_UP_LINK_TTL_DAYS=7
PUBLIC_CONTACT_EMAIL=
PUBLIC_DATA_CONTROLLER_NAME="DigiFlow (ten don vi mau - thay bang ten don vi that)"
PUBLIC_PRIVACY_EMAIL=
PUBLIC_DATA_RETENTION_NOTICE="Ban demo: du lieu duoc luu trong database local cho den khi nguoi van hanh xoa; can quy dinh thoi han truoc khi dung du lieu that."

# Local mặc định in email ra terminal. Chỉ đổi sang SMTP khi đã cấu hình tài khoản gửi.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=DigiFlow <no-reply@example.com>
